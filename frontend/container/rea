#!/bin/bash
# Runs this fork's REA inside the `rene` podman container. Agents and the
# workbench are registered to run this file instead of scripts/rea.mjs:
# `rea setup` sees REA_REGISTRATION_ENTRYPOINT and registers it.
#
# Provider settings (REA_*, JAVA_HOME, GHIDRA_INSTALL_DIR, ...) from the
# caller's environment are forwarded; everything else comes from the image.
# stdin/stdout pass through, so the workbench page's own `rea mcp` client
# works over stdio.
#
# Agents reach rene with `rene call`, never as an MCP server: as MCP tools rene
# sits beside the agent's own reader, writer and shell, which record nothing.
# This launcher is what agent registrations on this machine name, so it refuses
# MCP here, whatever an old or resumed session's configuration still says:
# `rea mcp` (and its subcommands) unless the workbench page started it
# (REA_WORKBENCH_MCP=page, set by frontend/server.mjs for its own client), and
# `rea setup` unless it only plans (--dry-run), since setup registers agents'
# MCP servers.
set -euo pipefail

refuse() {
  echo "rea: $1 Agents reach rene through \`rene call <tool> '<json>'\` in their shell; see AGENTS.md." >&2
  exit 77
}
case "${1:-}" in
  mcp | --mcp)
    [ "$#" -eq 1 ] && [ "${REA_WORKBENCH_MCP:-}" = page ] ||
      refuse "rene isn't served over MCP to agents."
    ;;
  setup)
    dry_run=
    for argument in "$@"; do [ "$argument" = --dry-run ] && dry_run=1; done
    [ -n "$dry_run" ] || refuse "rea setup registers rene as agents' MCP server, which this fork doesn't do."
    ;;
esac

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"
repo="$(cd "$here/../.." && pwd)"
name="${REA_CONTAINER_NAME:-rene}"

state="$(podman container inspect --format '{{.State.Status}}' "$name" 2>/dev/null || echo missing)"
case "$state" in
  running) ;;
  missing)
    echo "REA container '$name' doesn't exist; run frontend/start.sh in $repo." >&2
    exit 69
    ;;
  *) podman start "$name" >/dev/null ;;
esac

args=(exec --interactive --env "REA_REGISTRATION_ENTRYPOINT=$self")
[ -t 0 ] && [ -t 1 ] && args+=(--tty)
# The container mounts only the home folder; elsewhere, start from home.
case "$PWD/" in
  "$HOME"/*) args+=(--workdir "$PWD") ;;
  *) args+=(--workdir "$HOME") ;;
esac
while IFS= read -r variable; do
  case "$variable" in
    REA_REGISTRATION_ENTRYPOINT) ;;
    # GIT_CONFIG_*: an agent session's git configuration, which carries the
    # workbench's agent git hooks (the user makes every commit) into rene.
    REA_* | GHIDRA_* | HOPPER_* | JAVA_HOME | NO_COLOR | FORCE_COLOR | XDG_CACHE_HOME | XDG_CONFIG_HOME | XDG_DATA_HOME | GIT_CONFIG_COUNT | GIT_CONFIG_KEY_* | GIT_CONFIG_VALUE_*)
      args+=(--env "$variable=${!variable}")
      ;;
  esac
done < <(compgen -e)

exec podman "${args[@]}" "$name" node "$repo/scripts/rea.mjs" "$@"
